# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Editor and IDE-local files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example
auth.json

# Node.js dependencies and package-manager diagnostics
node_modules/
.pnpm-store/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js and Vercel generated files
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/.vercel/

# PHP dependencies and tool caches
vendor/
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache

# Laravel generated runtime data
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/public/storage
backend/storage/*.key
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore

# Test and coverage output
coverage/
test-results/
playwright-report/
blob-report/

# Common temporary files
*.tmp
*.temp
